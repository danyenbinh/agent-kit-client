      "stubSkillIds": ["unity-agent-runtime"],
      "setupScript": null
    },
    "pke": {
      "label": "Project Knowledge Engine",
      "description": "Live C# / prefab / reference index",
      "includedIn": ["pro", "studio"],
      "stubSkillIds": ["unity-live-index"],
      "requires": ["core"]
    },
    "vfx": {
      "label": "VFX Authoring",
      "description": "Particle catalog + bridge VFX",
      "includedIn": ["pro", "studio"],
      "stubSkillIds": ["unity-vfx-authoring"],
      "requires": ["core"]
    },
    "shadergraph": {
      "label": "Shader Graph",
      "description": "Shader Graph catalog + templates",
      "includedIn": ["studio"],
      "stubSkillIds": ["unity-shadergraph-authoring"],
      "requires": ["core"]
    },
    "figma-hud": {
      "label": "Figma HUD",
      "description": "Figma REST → HUD panel",
      "includedIn": ["studio"],
      "stubSkillIds": ["unity-figma-hud-authoring"],
      "requires": ["core"]
    },
    "builder": {
      "label": "Builder System",
