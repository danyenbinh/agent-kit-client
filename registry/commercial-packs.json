{
  "version": 1,
  "purpose": "Pack khách có thể mua. Stub luôn có trên client; runtime chỉ sau sync-entitled.",
  "licenseApiDefault": "http://localhost:8787",
  "packs": {
    "core": {
      "label": "Core",
      "description": "Bootstrap, ping, skill stub, license client",
