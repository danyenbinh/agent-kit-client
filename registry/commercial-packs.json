  "neverShipToClient": [
    "agent-kit-promotion",
    "agent-core-governance",
    "agent-north-star",
    "agent-skill-registry",
    "agent-skill-lifecycle",
    "agent-project-orchestrator",
    "TemplatePro",
    "kit-dev"
